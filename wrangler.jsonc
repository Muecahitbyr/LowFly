{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fahrschule-low-fly",
  "compatibility_date": "2026-11-10",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Worker zuerst ausführen, damit die www-Weiterleitung auch für
    // vorhandene Dateien greift
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "fahrschule-low-fly.de", "custom_domain": true },
    { "pattern": "www.fahrschule-low-fly.de", "custom_domain": true }
  ]
}
